<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="$(ArtifactsPath)/BackgroundJobs.Packages.props" Condition="Exists('$(ArtifactsPath)/BackgroundJobs.Packages.props')" />
  <PropertyGroup>
    <BackgroundJobsPackageVersion Condition="'$(BackgroundJobsPackageVersion)' == ''">1.0.0</BackgroundJobsPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BackgroundJobs" Version="$(BackgroundJobsPackageVersion)" />
    <PackageReference Include="BackgroundJobs.Dashboard" Version="$(BackgroundJobsPackageVersion)" />
  </ItemGroup>

  <Target Name="EnsureLocalPackages" BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition="!Exists('$(ArtifactsPath)/BackgroundJobs.Packages.props')">
    <Error Text="Build the local packages first: dotnet msbuild build.proj -t:Build." />
  </Target>
</Project>
